{
  "name": "@local/sidebar-menu",
  "version": "0.2.0",
  "private": true,
  "description": "自定义 DSH 左侧「全局面板」菜单哪些项显示、哪些隐藏",
  "author": "Winjazw",
  "license": "MIT",
  "homepage": "https://github.com/Winjazw/dsh-sidebar-menu#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Winjazw/dsh-sidebar-menu.git"
  },
  "bugs": {
    "url": "https://github.com/Winjazw/dsh-sidebar-menu/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "sidebar",
    "customize",
    "plugin"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.0-rc.2"
  },
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./icon": "./icon.svg",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    },
    "compatibility": {
      "dshReleases": {
        "0.2.1-rc.2": "compatible"
      }
    }
  }
}
